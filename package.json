{
  "name": "connectivity",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "test": "turbo test --log-order=grouped",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:eslint": "eslint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome check",
    "publint": "turbo run publint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test:types": "turbo run test:types --log-order=grouped",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
    "changeset:publish": "changeset publish",
    "clean": "find . -name 'dist' -type d -prune -exec rm -rf {} +",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "clean:all": "pnpm run clean && pnpm run clean:node_modules"
  },
  "keywords": [],
  "author": "@minseong0324 <KIM Minseong>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@changesets/cli": "^2.29.8",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "10.1.0",
    "eslint-plugin-no-misleading-return-type": "^0.7.3",
    "happy-dom": "^20.7.0",
    "knip": "^5.84.1",
    "next": "^16.1.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "publint": "^0.3.17",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "type": "module"
}
