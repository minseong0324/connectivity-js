{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/tests/**",
      "packages/*/*.config.*",
      "docs/app/**/*.{ts,tsx}",
      "docs/components/**/*.{ts,tsx}",
      "docs/*.{ts,tsx,mjs}",
      "knip.json",
      "turbo.json",
      "tsconfig.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useBlockStatements": "warn"
      },
      "nursery": {
        "noMisleadingReturnType": "warn"
      }
    }
  },
  "assist": { "enabled": true },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  }
}
