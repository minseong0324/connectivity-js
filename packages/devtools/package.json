{
  "name": "@connectivity-js/devtools",
  "version": "0.3.6",
  "description": "Framework-agnostic devtools panel for Connectivity",
  "author": "@minseong0324 <KIM Minseong>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minseong0324/connectivity-js.git",
    "directory": "packages/devtools"
  },
  "keywords": [
    "connectivity",
    "devtools",
    "debugging"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "homepage": "https://connectivity-js-docs.vercel.app/en",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@connectivity-js/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "tsdown": "^0.20.3",
    "vitest": "^4.0.18"
  }
}
